{
  "name": "@ggui-ai/mcp-apps-react",
  "version": "0.14.0",
  "description": "React SDK for ggui — components and hooks for embedding agent-generated UIs in web apps.",
  "keywords": [
    "ggui",
    "react",
    "mcp",
    "ai-agent",
    "generative-ui",
    "sdk"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/ggui-ai/ggui/tree/main/packages/mcp-apps-react",
  "repository": {
    "type": "git",
    "url": "https://github.com/ggui-ai/ggui.git",
    "directory": "packages/mcp-apps-react"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./chat-helpers": {
      "types": "./dist/chat-helpers/index.d.ts",
      "import": "./dist/chat-helpers/index.mjs",
      "require": "./dist/chat-helpers/index.js"
    }
  },
  "scripts": {
    "build": "TSUP_OUT_DIR=dist.staging-$$ tsup && node ../scripts/atomic-swap.mjs dist.staging-$$ dist",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node ../../e2e/fixtures/silverprotocol/fetch-fixtures.mjs && vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@ggui-ai/protocol": "workspace:*",
    "@ggui-ai/iframe-runtime": "workspace:*",
    "@ggui-ai/wire": "workspace:*"
  },
  "devDependencies": {
    "@ggui-ai/design": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "@silverprotocol/core": "0.5.4",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^24.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.6"
  },
  "bugs": {
    "url": "https://github.com/ggui-ai/ggui/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "ggui contributors <hello@ggui.ai>"
}
