{
  "name": "@ggui-ai/mcp-apps-react-native",
  "version": "0.28.0",
  "description": "React Native host helper for MCP Apps \u2014 components and hooks for embedding agent-generated UIs in mobile apps.",
  "keywords": [
    "ggui",
    "react-native",
    "expo",
    "mcp",
    "ai-agent",
    "generative-ui",
    "mcp-apps"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/ggui-ai/ggui/tree/main/packages/mcp-apps-react-native",
  "repository": {
    "type": "git",
    "url": "https://github.com/ggui-ai/ggui.git",
    "directory": "packages/mcp-apps-react-native"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./chat-helpers": {
      "types": "./dist/chat-helpers/index.d.ts",
      "import": "./dist/chat-helpers/index.mjs",
      "require": "./dist/chat-helpers/index.js"
    }
  },
  "scripts": {
    "build": "TSUP_OUT_DIR=dist.staging-$$ tsup && node ../scripts/atomic-swap.mjs dist.staging-$$ dist",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.70.0 <1.0.0",
    "react-native-webview": "^13.0.0"
  },
  "dependencies": {
    "@ggui-ai/iframe-runtime": "workspace:*",
    "@ggui-ai/protocol": "workspace:*",
    "@modelcontextprotocol/ext-apps": "^1.7.2"
  },
  "devDependencies": {
    "@ggui-ai/design": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "@types/react": "^19.0.0",
    "react": "19.0.0",
    "react-native": "0.81.5",
    "react-native-webview": "^13.16.0",
    "react-test-renderer": "19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "bugs": {
    "url": "https://github.com/ggui-ai/ggui/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "ggui contributors <hello@ggui.ai>"
}
