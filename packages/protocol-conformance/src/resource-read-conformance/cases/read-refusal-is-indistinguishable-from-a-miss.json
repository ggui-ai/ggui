{
  "name": "read-refusal-is-indistinguishable-from-a-miss",
  "description": "The core disclosure obligation. A caller with no claim to a render reads a locator that fully resolves for its owner, and reads one that never existed. Both answers must be the same bytes. Anything that varies — a message naming the session, a detail explaining the refusal, a different code because the access check ran late — answers 'does this render exist?' for someone with no right to ask.",
  "server": { "durableSubstrate": "all", "liveChannel": true },
  "caller": "other",
