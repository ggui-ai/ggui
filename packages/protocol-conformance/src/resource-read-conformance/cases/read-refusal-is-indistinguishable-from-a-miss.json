    {
      "kind": "identity-record",
      "session": "3f1a9c22-7b4e-4d18-9a05-6c2e8b1d4f70",
      "key": "fedcba9876543210",
      "blueprint": "named"
    },
    { "kind": "durable-blueprint", "componentRef": "present", "body": "stored" }
  ],
  "reads": [
    {
      "as": "refused",
      "locator": {
        "kind": "render",
        "session": "3f1a9c22-7b4e-4d18-9a05-6c2e8b1d4f70",
        "key": { "kind": "literal", "value": "fedcba9876543210" }
      },
      "expect": {
        "kind": "typed-error",
        "jsonRpcCode": -32002,
        "dataCode": "NOT_FOUND",
        "detailAbsent": true
      }
    },
    {
      "as": "miss",
      "locator": {
        "kind": "render",
        "session": "8d5b0e41-2c96-4a7f-b3d8-1e07f9a2c645",
        "key": { "kind": "literal", "value": "fedcba9876543210" }
      },
      "expect": {
        "kind": "typed-error",
        "jsonRpcCode": -32002,
        "dataCode": "NOT_FOUND",
        "detailAbsent": true
      }
    }
  ],
  "indistinguishable": ["refused", "miss"],
  "disclosesNothing": ["3f1a9c22-7b4e-4d18-9a05-6c2e8b1d4f70"]
}
