{
  "$comment": "Per-canvas presentation vectors for judge-input.json `canvasPresentations`: each row is an input and the read it must produce (applied, and malformed with its reason). A malformed entry drops only its own canvas; duplicates drop every entry for that canvas. Both the writer's reader and the judge's reader pin to this table, byte for byte.",
  "version": 1,
  "reasons": [
    "not_an_object",
    "unknown_canvas",
    "canvas_not_judged",
    "duplicate_canvas",
    "label_missing",
    "box_out_of_bounds",
    "box_on_declared_primary",
    "color_not_hex",
    "frame_off_inline",
    "frame_malformed",
    "ground_on_inline"
  ],
