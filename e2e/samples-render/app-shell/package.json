{
  "name": "samples-render-app",
  "version": "0.0.0",
  "private": true,
  "description": "Harness-owned workspace wrapper for the samples-render e2e — composed with oss/samples/* by compose-app.mjs into a runnable 4-server agentic app. The root name is rewritten to rendercell-<sdk> at compose time.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ggui": "dotenv -e .env.local -- pnpm --filter ./servers/ggui start",
    "dev:mcps": "pnpm --parallel --filter \"./servers/mcps/*\" run dev",
    "dev:todo": "pnpm --filter ./servers/mcps/todo dev",
    "dev:agent": "dotenv -e .env.local -- pnpm --filter ./servers/agent dev",
    "dev:web": "pnpm --filter ./apps/web dev",
    "dev:stop": "node scripts/stop-dev.mjs",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0"
  }
}
